JOIN `jurusan` ON `jurusan`.`id` = `jadwal_kuliah`.`jurusan_id`
JOIN `prodi` ON `prodi`.`id` = `jadwal_kuliah`.`prodi_id`
JOIN `kelas_master` ON `jadwal_kuliah`.`kelas_master_id` = `kelas_master`.`id`
JOIN `kelas_detail` ON `kelas_detail`.`kelas_master_id` = `kelas_master`.`id`
JOIN `mahasiswa` ON `kelas_detail`.`mahasiswa_id` = `mahasiswa`.`id`
JOIN `gedung` ON `gedung`.`id` = `jadwal_kuliah`.`gedung_id`
JOIN `matakuliah` ON `matakuliah`.`id` = `jadwal_kuliah`.`matakuliah_id`
WHERE `jadwal_kuliah`.`id` IN ((SELECT jadwal_kuliah_id FROM rencana_perkuliahan WHERE rencana_perkuliahan.tanggal = \'2024-02-18\')) OR `jadwal_kuliah`.`hari` = \'minggu\'
AND `tahun_akademik`.`status` = :tahun_akademik.status:
AND `mahasiswa`.`npm` = :mahasiswa.npm:
GROUP BY `jadwal_id`', [...], false)
